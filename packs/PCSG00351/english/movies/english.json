  "stories": {
    "MP00_000_000": {
      "sha256": "5f9e0cc093700b8b1eae8949ae92b5b35e5101952ef6c0f3d818afd7d6a32bb9",
      "top": 470,
      "bottom": 497,
      "threshold": 350,
      "frames": 3407,
      "expected_lines": 27,
      "presence_bits": "",
      "cues": {
        "0": "",
        "1": "",
        "2": "Oracle.",
        "3": "A vast fleet roaming freely between planets.",
        "4": "",
        "5": "ARKS, a force formed within Oracle,",
        "6": "lands on the countless planets it finds wherever it goes",
        "7": "and surveys them for the sake of peace in the universe.",
        "8": "An absolute evil that threatens the peace\nof the whole universe: the Darkers.",
        "9": "Wiping them out is ARKS's greatest purpose.",
        "10": "No one else can exterminate the Darkers.",
        "11": "Only ARKS, who wield photons, can do it.",
        "12": "To keep the whole universe from being\nengulfed by the Darkers' darkness,",
        "13": "ARKS traveled from star to star,\nfighting on day after day.",
        "14": "ARKS is made up of three races.",
        "15": "",
        "16": "Humans, who excel in balance;",
        "17": "Newmans, skilled at handling photons;",
        "18": "and Casts, with their sturdy bodies.",
        "19": "By supporting and working with each other,\nthey make ARKS what it is.",
        "20": "And now, the exploration ship of Alter,\nARKS's advance team, has left the fleet",
        "21": "and set course for a certain planet\non a new survey.",
        "22": "It was a planet that allowed no direct warp link,\nmuch of it shrouded in mystery.",
        "23": "Does the shadow of the Darkers lie there...",
        "24": "",
        "25": "or does an unprecedented threat lurk...",
        "26": "...No one knows yet."
      },
