    "MP09_040_040": {
      "sha256": "24fe19b0b4e9d1fd082293352e4ba67edefb002a8b5b72f19fe72c1605268197",
      "top": 464,
      "bottom": 491,
      "threshold": 700,
      "frames": 8037,
      "expected_lines": 53,
      "presence_bits": "",
      "cues": {
        "0": "We did it!!",
        "1": "",
        "2": "",
        "3": "Her back... No way!!",
        "4": "What!?",
        "5": "",
        "6": "The reason Raven refused\nJuno's mission was...!",
        "7": "For Juno's sake...?",
        "8": "No! That's not okay!!",
        "9": "Stopping Nova and its kin\nis my mission.",
        "10": "It is the last wish of the people\nwho lived on this planet.",
        "11": "And besides...",
        "12": "I want to help all of you.",
        "13": "",
        "14": "Juno...",
        "15": "You really are something...",
        "16": "",
        "17": "",
        "18": "Let's watch Juno give it her all,",
        "19": "",
        "20": "and the moment she fulfills her mission...!",
        "21": "Hm? Hey! Are you okay!?",
        "22": "Nova... is still resisting...!",
        "23": "Nova is recovering...!?",
        "24": "So an awakened Nova\nreally can't be stopped...!!",
        "25": "Don't give in!!",
        "26": "I won't give up...\nnot until the end...!!",
        "27": "Juno!! Picture yourself succeeding!!",
        "28": "...Please, help me...!",
        "29": "",
        "30": "",
        "31": "",
        "32": "",
        "33": "I will be a hero\nfor just one person.",
        "34": "That's what I promised...!",
        "35": "Nova.",
        "36": "The humans who created you",
        "37": "and made a promise with you to guard\nthis planet have perished.",
        "38": "Your role is over.\nThe time has come to sleep.",
        "39": "\"We were born to guard the planet,\nfought invaders, and guard it still.\"",
        "40": "\"The planet is still here.\nOur role is not over.\"",
        "41": "I declare the promise ended.",
        "42": "",
        "43": "I too will join you\nin eternal sleep.",
        "44": "\"Princess, we ask you.\"",
        "45": "\"Did we fulfill our role...?\"",
        "46": "...Yes.",
        "47": "\"I see...\"",
        "48": "\"I see...\"",
        "49": "Raven...",
        "50": "The promise I once made with you",
        "51": "has brought about this ending.",
        "52": "You are my hero."
      },
